[Unit]
Description=Jerico self-hosted PostgreSQL and ClickHouse backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=jerico
Group=jerico
SupplementaryGroups=docker
WorkingDirectory=/opt/jerico
ExecStart=/usr/bin/bash /opt/jerico/scripts/self-hosted/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
