# Copy this file to the repository root as .env.
# Use URL-safe random values (letters and numbers) for database passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-another-long-random-alphanumeric-secret
QUEUE_ADMIN_TOKEN=replace-with-at-least-32-random-characters
QUEUE_WORKER_PORT=8789
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=20
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
QUEUE_POLL_INTERVAL_MS=1000
INGEST_PORT=8788
INGEST_DAILY_EVENT_LIMIT=100000
INGEST_RATE_LIMIT_REQUESTS=120
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
INGEST_DATABASE_POOL_MAX=12
