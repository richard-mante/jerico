# Copy this file to the repository root as .env.
# Use URL-safe random values (letters and numbers) for database passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-another-long-random-alphanumeric-secret
QUEUE_ADMIN_TOKEN=replace-with-at-least-32-random-characters
QUEUE_WORKER_PORT=8789
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=20
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
QUEUE_POLL_INTERVAL_MS=1000
INGEST_PORT=8788
INGEST_DAILY_EVENT_LIMIT=100000
INGEST_RATE_LIMIT_REQUESTS=120
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
INGEST_DATABASE_POOL_MAX=12
API_PORT=8787
BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
WEB_APP_URL=https://app.example.com
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPTIME_RESULTS_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_DELIVERY_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
API_DATABASE_POOL_MAX=12
NEXT_PUBLIC_API_URL=https://api.example.com
WEB_PORT=3000
