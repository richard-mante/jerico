# Copy this file to the repository root as .env.
# Use URL-safe random values (letters and numbers) for database passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-another-long-random-alphanumeric-secret
QUEUE_ADMIN_TOKEN=replace-with-at-least-32-random-characters
QUEUE_WORKER_PORT=8789
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=20
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
QUEUE_POLL_INTERVAL_MS=1000
INGEST_PORT=8788
INGEST_DAILY_EVENT_LIMIT=100000
INGEST_RATE_LIMIT_REQUESTS=120
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
INGEST_DATABASE_POOL_MAX=12
API_PORT=8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPTIME_RESULTS_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_DELIVERY_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
API_DATABASE_POOL_MAX=12
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
INGEST_DOMAIN=ingest.example.com
ACME_EMAIL=admin@example.com
# 0 disables automatic local backup pruning; set a positive number to retain recent manifests/artifacts.
BACKUP_RETENTION_DAYS=0

# Optional client-side backup encryption (age). Leave empty to keep backups unencrypted.
# AGE_RECIPIENT=age1...
# Set AGE_IDENTITY only when restoring an encrypted backup; keep the private key outside this server.
# AGE_IDENTITY=/secure/path/backup-identity.txt

# Optional encrypted off-site backup destination (rclone remote:path).
# Requires AGE_RECIPIENT and the rclone binary; remote credentials should live in a private config file.
# RCLONE_REMOTE=r2:jerico-backups/production
# RCLONE_CONFIG=/secure/path/rclone.conf
