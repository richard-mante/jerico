# PostgreSQL and ClickHouse are required.
DATABASE_URL=postgresql://jerico:jerico@localhost:5432/jerico
CLICKHOUSE_URL=http://localhost:8123

# Optional ClickHouse authentication.
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_TOKEN=

# Bind to localhost by default. Use 0.0.0.0 only on a private container network.
HOST=127.0.0.1
PORT=8789

# Set a high-entropy token (at least 32 characters) to enable dead-letter admin routes.
# QUEUE_ADMIN_TOKEN=

# Optional queue tuning.
# QUEUE_MAX_ATTEMPTS=5
# QUEUE_BATCH_SIZE=20
# QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
# QUEUE_POLL_INTERVAL_MS=1000
# DATABASE_POOL_MAX=8
