# Local-only ClickHouse connection. Copy to .dev.vars and replace placeholders.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=jerico
CLICKHOUSE_TABLE=telemetry_events
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# Public HTTPS URL of the Jerico API Worker
API_URL=https://your-jerico-api.workers.dev
# Must match apps/api UPTIME_RESULTS_SECRET
UPTIME_RESULTS_SECRET=replace-with-a-long-random-secret

# Exact workers.dev hostname of this probe Worker; it is blocked as a probe target
PROBE_WORKER_HOST=jerico-worker.your-account.workers.dev
