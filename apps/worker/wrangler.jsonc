{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jerico-worker",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "queues": {
    "consumers": [
      {
        "queue": "jerico-telemetry",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "jerico-telemetry-dlq"
      },
      {
        "queue": "jerico-uptime-probes",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "jerico-uptime-probes-dlq"
      },
      {
        "queue": "jerico-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "jerico-notifications-dlq"
      },
      {
        "queue": "jerico-uptime-probes-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100
      },
      {
        "queue": "jerico-notifications-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100
      }
    ]
  }
}
