{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jerico-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "queues": {
    "producers": [
      {
        "binding": "TELEMETRY_QUEUE",
        "queue": "jerico-telemetry"
      }
    ]
  }
}
