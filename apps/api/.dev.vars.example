APP_ENV=development
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
WEB_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://jerico:jerico@localhost:5432/jerico
RESEND_API_KEY=
EMAIL_FROM=Jerico <no-reply@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ClickHouse query access for the observability API
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=jerico
CLICKHOUSE_TABLE=telemetry_events
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TOKEN=

# Shared secret used only by the internal uptime result callback (generate at least 32 random bytes)
UPTIME_RESULTS_SECRET=replace-with-a-long-random-secret

# Shared secret for internal notification delivery callbacks (match the Worker value)
NOTIFICATION_DELIVERY_SECRET=replace-with-a-long-random-secret

# Base64url-encoded 32-byte AES-GCM key; use the same value on API and Worker
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
