{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jerico-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  "queues": {
    "producers": [
      { "binding": "UPTIME_PROBES", "queue": "jerico-uptime-probes" }
    ]
  }
}
