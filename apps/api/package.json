{
  "name": "@jerico/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .wrangler",
    "test:integration": "vitest run src/telemetry-query.integration.test.ts"
  },
  "dependencies": {
    "@jerico/contracts": "workspace:*",
    "@jerico/database": "workspace:*",
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.7",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
